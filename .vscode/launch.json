{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ts-tracker ingest",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/ts-tracker",
      "args": ["ingest"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "cli.py: ingest",
      "type": "debugpy",
      "request": "launch",
      "module": "ts_tracker.cli",
      "args": ["ingest"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ts-tracker hierarchy",
      "type": "debugpy",
      "request": "launch",
      "module": "ts_tracker.cli",
      "args": ["hierarchy"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ts-tracker (pick a subcommand)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/ts-tracker",
      "args": ["${input:subcommand}"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-x", "-q"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "subcommand",
      "type": "pickString",
      "description": "ts-tracker subcommand",
      "options": ["ingest", "validate", "hierarchy", "data", "bench"],
      "default": "ingest"
    }
  ]
}
